# Copiar este archivo a `.env` y completar los valores.

# ===== Ollama =====
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=gemma2:9b
LLM_UTILITY_MODEL=gemma2:9b
LLM_TEMPERATURE=0.2

# ===== Embeddings =====
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto            # auto | cuda | cpu
CHROMA_COLLECTION_NAME=lia_bge_m3

# ===== Retrieval =====
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
HYBRID_BM25_WEIGHT=0.3
HYBRID_VECTOR_WEIGHT=0.7
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
ENABLE_CONTEXTUAL_RETRIEVAL=true
ENABLE_QUERY_REWRITING=true
LOW_CONFIDENCE_THRESHOLD=0.2

# ===== Chunking =====
PARENT_CHUNK_SIZE=1800
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=50

# ===== Guardrails =====
ENABLE_DOMAIN_GUARDRAIL=true
ENABLE_LOW_CONFIDENCE_GUARDRAIL=true

# ===== LangFuse (self-hosted) =====
# Completar tras correr `docker compose up -d` y crear el proyecto en http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
